# react-wordcloud@1.2.7 declares a peer range that predates React 18 and is no
# longer maintained. React 18 works with it; npm's strict peer resolution does
# not know that, and refuses to install.
#
# Declaring it here is what replaced the previous workaround, which was to run
# `npm install react-day-picker@9.6.4 --no-save` inside the build script —
# a mid-build network install that made the build non-reproducible.
legacy-peer-deps=true
